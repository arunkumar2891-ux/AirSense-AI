# AI provider. If AI_API_KEY is unset, the app uses its deterministic local assistant.
AI_PROVIDER=gemini
AI_API_KEY=
# Gemini Flash model. See https://ai.google.dev/gemini-api/docs/models
AI_MODEL=gemini-3.8-flash
# AI tuning (optional)
# Overall Gemini operation deadline, including retries and backoff
#AI_TIMEOUT_MS=18000
#AI_MAX_RETRIES=2
#AI_MAX_OUTPUT_TOKENS=1024
PORT=10000

# Rate limiting for POST /api/assistant (per client IP)
#ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
#ASSISTANT_RATE_LIMIT_MAX=20
# Air-quality data endpoint (per client IP)
#DATA_RATE_LIMIT_WINDOW_MS=60000
#DATA_RATE_LIMIT_MAX=60
# Location search and fallback endpoint (per client IP)
#GEOCODE_RATE_LIMIT_WINDOW_MS=60000
#GEOCODE_RATE_LIMIT_MAX=30

# Bounded upstream cache
#CACHE_MAX_ENTRIES=500
#ENVIRONMENT_CACHE_TTL_MS=600000
#GEOCODE_CACHE_TTL_MS=86400000

# Extra origins allowed by CORS in production (comma-separated, same-origin needs none)
#ALLOWED_ORIGINS=https://your-domain.example
